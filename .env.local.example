# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://paperclip:paperclip@127.0.0.1:5432/paperclip

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-openssl-rand-base64-32

# ── Email (magic links via Resend) ────────────────────────────────────────────
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=re_your_resend_api_key
EMAIL_FROM=noreply@contentforge.com
RESEND_API_KEY=re_your_resend_api_key

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── FanBasis ──────────────────────────────────────────────────────────────────
FANBASIS_API_KEY=your-fanbasis-api-key
FANBASIS_WEBHOOK_SECRET=your-fanbasis-webhook-secret
FANBASIS_PRICE_SOLO=price_solo_id_from_fanbasis
FANBASIS_PRICE_BUSINESS=price_business_id_from_fanbasis
FANBASIS_PRICE_AGENCY=price_agency_id_from_fanbasis

# ── Founding member prices (annual billing, rate locked forever) ───────────────
# Create these as annual recurring prices in FanBasis: $588/yr, $1188/yr, $2088/yr
FANBASIS_FOUNDING_PRICE_SOLO=price_founding_solo_id_from_fanbasis
FANBASIS_FOUNDING_PRICE_BUSINESS=price_founding_business_id_from_fanbasis
FANBASIS_FOUNDING_PRICE_AGENCY=price_founding_agency_id_from_fanbasis

# ── Internal agent auth ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CONTENTFORGE_INTERNAL_SECRET=replace-with-random-secret
