# PostgreSQL — Neon, Supabase, or self-hosted
DATABASE_URL=postgresql://user:password@host:5432/signalforge

# Anthropic Claude API — used by Scoring Agent
ANTHROPIC_API_KEY=sk-ant-...

# Bearer token for internal agent heartbeat endpoints (/api/internal/*)
# Generate with: openssl rand -hex 32
INTERNAL_AGENT_SECRET=your-secret-here

# Shared secret for Make.com webhook (sent as x-make-secret header)
MAKE_WEBHOOK_SECRET=your-make-secret-here

# Staff API key — required header (x-staff-api-key) for all /api/clients/* and /api/leads/* routes
# Generate with: openssl rand -hex 32
STAFF_API_KEY=your-staff-api-key-here

# NextAuth — magic-link auth via Resend
AUTH_SECRET=your-nextauth-secret-here
AUTH_RESEND_KEY=re_...
AUTH_URL=http://localhost:3000

# App URL — used for OAuth redirect URIs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Search Console — optional, enables GSC keyword gap integration
# Create OAuth 2.0 credentials at console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: $NEXT_PUBLIC_APP_URL/api/integrations/gsc/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe — optional, enables subscriptions, credit checkout, and auto top-up
# Set STRIPE_SECRET_KEY to activate; leave blank to run in manual-only mode
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook events to enable: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted,
# invoice.payment_failed, payment_intent.succeeded
# Stripe Price IDs — create one recurring price per plan/cycle in the Stripe dashboard
STRIPE_PRICE_FLOOR_MONTHLY=price_...
STRIPE_PRICE_FLOOR_ANNUAL=price_...
STRIPE_PRICE_GUIDED_MONTHLY=price_...
STRIPE_PRICE_GUIDED_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...
